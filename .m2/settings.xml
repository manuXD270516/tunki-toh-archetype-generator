<!-- ============================================================
     settings.xml — Configuracion local para Azure Artifacts
     Feed: BackendArtifactsInDigitalpePro@Local (Organization scope)

     INSTRUCCIONES:
     1. Copiar este archivo a ~/.m2/settings.xml
     2. Generar un PAT (Personal Access Token) en Azure DevOps:
        - Ir a: https://dev.azure.com/InDigitalpe/_usersSettings/tokens
        - Scope: Packaging → Read & Write
     3. Reemplazar [PERSONAL_ACCESS_TOKEN] con tu token generado

     Una vez configurado, Maven resuelve automaticamente todas las
     dependencias pe.oh.sip.* desde el feed privado.
     ============================================================ -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
          https://maven.apache.org/xsd/settings-1.0.0.xsd">

    <servers>
        <server>
            <id>BackendArtifactsInDigitalpePro@Local</id>
            <username>InDigitalpe</username>
            <password>[PERSONAL_ACCESS_TOKEN]</password>
        </server>
    </servers>

    <profiles>
        <profile>
            <id>indigitalpe-backend</id>
            <repositories>
                <repository>
                    <id>BackendArtifactsInDigitalpePro@Local</id>
                    <name>InDigitalpe Backend Maven Feed</name>
                    <url>https://pkgs.dev.azure.com/InDigitalpe/_packaging/BackendArtifactsInDigitalpePro%40Local/maven/v1</url>
                    <releases>
                        <enabled>true</enabled>
                    </releases>
                    <snapshots>
                        <enabled>true</enabled>
                    </snapshots>
                </repository>
            </repositories>
        </profile>
    </profiles>

    <activeProfiles>
        <activeProfile>indigitalpe-backend</activeProfile>
    </activeProfiles>

</settings>
